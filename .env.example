# All files and the SQLite audit log remain on this machine by default.
GPI_POLICY_PATH=policy.local.json
GPI_DATA_DIR=customer_data
GPI_BIND=127.0.0.1
GPI_PORT=8787

# Optional BYOK model path. Leave all three unset for offline-only use.
# The runtime accepts HTTPS endpoints, or localhost endpoints for a local model.
# GPI_MODEL_PROVIDER=openai_responses
# GPI_MODEL_BASE_URL=https://api.openai.com
# GPI_MODEL_NAME=your-model-name
# Set this in the shell or a local .env file. Never commit an actual key.
# GPI_MODEL_API_KEY=replace-with-your-own-key
